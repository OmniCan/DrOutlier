# PHP Frontend Configuration

# Application
APP_NAME="DrOutlier"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# API Configuration (Laravel Backend)
API_BASE_URL=http://localhost/admin/application/public/api
API_TIMEOUT=30

# Session
SESSION_LIFETIME=120
SESSION_COOKIE_NAME=droutlier_session

# Firebase (if still needed for notifications)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
