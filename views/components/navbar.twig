<header class="header-wrapper">
    <div class="header-inner">
        <nav class="navbar navbar-dark">
            <div class="container">
                <div class="col-lg-4 col-2">
                    <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar" aria-label="Toggle navigation">
                        <img src="/images/Toggle.svg" class="img-fluid" alt="Toggle" />
                    </button>
                </div>
                
                <div class="col-lg-4 col-7 text-center">
                    <a class="navbar-brand col-md-2" href="{{ url('/') }}">
                        <img src="/images/Header-Logo.webp" class="img-fluid" alt="Dr Outlier Radiology" />
                    </a>
                </div>

                <div class="col-lg-4 col-2 d-flex justify-content-end">
                    {% if auth %}
                        <div class="btn-group">
                            <div data-bs-toggle="dropdown" class="dropDown-wrap" style="cursor: pointer;">
                                {# For phone view - Avatar #}
                                <div class="d-lg-none">
                                    <img src="/images/avatar.png" alt="Avatar" style="width: 40px; height: 40px; border-radius: 50%;" />
                                </div>

                                {# For large screens - Username #}
                                <div class="d-none d-lg-block">
                                    <img alt="Login Logo" src="/images/login-logo.svg" />
                                    {{ user.name|default('User') }}
                                </div>

                                <i class="fa-solid fa-chevron-down d-none d-lg-block"></i>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a href="{{ url('/subscription') }}" class="dropdown-item" style="display: flex; align-items: center; gap: 8px;">
                                        <i class="fas fa-crown" style="color: #126E97;"></i>
                                        My Subscription
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255, 255, 255, 0.1);" /></li>
                                <li>
                                    <a href="{{ url('/profile') }}" class="dropdown-item" style="display: flex; align-items: center; gap: 8px;">
                                        <i class="fas fa-user-circle" style="color: #126E97;"></i>
                                        Profile
                                    </a>
                                </li>
                                <li>
                                    <a href="{{ url('/bookmarks') }}" class="dropdown-item" style="display: flex; align-items: center; gap: 8px;">
                                        <i class="fas fa-bookmark" style="color: #126E97;"></i>
                                        Saved / Bookmarks
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255, 255, 255, 0.1);" /></li>
                                <li>
                                    <form action="{{ url('/logout') }}" method="POST" style="margin: 0;">
                                        <button class="dropdown-item" type="submit" style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                            <i class="fas fa-sign-out-alt" style="color: #FF5252;"></i>
                                            Log Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    {% else %}
                        <button class="btn btn-link loginBtn d-lg-block d-none" data-bs-toggle="modal" data-bs-target="#loginModal">
                            <i class="fa-solid fa-user"></i> Login
                        </button>
                    {% endif %}

                    <button class="btn btn-link searchBtn d-lg-none d-block">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>

                {# Offcanvas Menu #}
                <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="offcanvasDarkNavbarLabel">
                            <span>Welcome to <strong>Dr. Outlier</strong></span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="{{ url('/') }}">
                                    Home
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ url('/notes') }}">
                                    Theory Notes
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ url('/new-spotters') }}">
                                    Spotters
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ url('/new-osce') }}">
                                    OSCE
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ url('/new-exam-cases') }}">
                                    AI-Rad
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ url('/new-table-viva') }}">
                                    Practical Essentials
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ url('/watch-and-learn') }}">
                                    Watch &amp; Learn
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </div>
</header>

{# Font Awesome Icons #}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    </div>
</nav>
